{
  "name": "stitch-snuggle",
  "version": "0.1.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "gen:art": "node scripts/gen-art-manifest.mjs",
    "gen:voice": "node scripts/gen-voice-manifest.mjs",
    "lint": "eslint . --max-warnings=0",
    "gen:voice-ids": "node scripts/gen-voice-ids.mjs",
    "visual": "jest -c jest.visual.config.js",
    "gen:credits": "node scripts/gen-credits.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "~57.0.28",
    "expo-audio": "~57.0.5",
    "expo-file-system": "~57.0.7",
    "expo-screen-orientation": "~57.0.3",
    "expo-speech": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.ts?(x)"
    ]
  },
  "overrides": {
    "expo-asset": "~57.0.20"
  }
}
